# OmniMCP control plane configuration (copied to .env; never commit .env)
OMNIMCP_ENV=development
OMNIMCP_HOST=127.0.0.1
OMNIMCP_PORT=8000
OMNIMCP_DATABASE_URL=sqlite+aiosqlite:///./omnimcp.db
# REQUIRED in production:
OMNIMCP_SECRET_KEY=
# MCP endpoint bearer token (recommended; in production required unless
# OMNIMCP_MCP_UNAUTHENTICATED_PROXY=true declares an authenticated reverse proxy)
OMNIMCP_MCP_TOKEN=
# Optional bootstrap admin (else first registered user becomes admin)
OMNIMCP_BOOTSTRAP_ADMIN_EMAIL=
OMNIMCP_BOOTSTRAP_ADMIN_PASSWORD=
# Storage
OMNIMCP_STORAGE_ROOT=./data/storage
OMNIMCP_WORKSPACE_ROOT=./data/workspaces
# GCS / HF (adapters stay inert until set)
OMNIMCP_GCS_BUCKET=
OMNIMCP_HF_REPO=
# Google application credentials for GCS (path or JSON), standard ADC
GOOGLE_APPLICATION_CREDENTIALS=
